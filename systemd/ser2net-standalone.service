[Unit]
# The standalone Linux binary (ser2net-linux-x64 / ser2net-linux-arm64 of a release) as a
# service; a source checkout in /opt/ser2net uses ser2net.service instead. Install it as
# ser2net.service (README: "Run as a service"):
#   sudo install -m 0755 ser2net-linux-x64 /usr/local/bin/ser2net
#   sudo useradd --system --user-group --home-dir /var/lib/ser2net -M -s /usr/sbin/nologin ser2net
#   sudo cp ser2net-standalone.service /etc/systemd/system/ser2net.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now ser2net
# Its data (config.json, logs) is in /var/lib/ser2net, which systemd makes for the service
# user (StateDirectory=). To upgrade, replace /usr/local/bin/ser2net and restart.
Description=ser2net — serial-to-network bridge with web config UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated unprivileged user that is a member of the 'dialout' group
# so it can open serial devices (NEVER run this as root).
User=ser2net
SupplementaryGroups=dialout
StateDirectory=ser2net
StateDirectoryMode=0700
# On a headless first boot the console picker is non-interactive and defaults the
# admin UI to 127.0.0.1:8080 (loopback, never network-exposed without an explicit
# choice). To expose it on the LAN, run "systemctl edit ser2net" and add
#   [Service]
#   Environment=SER2NET_BIND_IP=0.0.0.0 SER2NET_PORT=8080
# Commands run by hand on this data directory go as the service user, never as root
# (root would own what they write, and the service could no longer read it):
#   sudo -u ser2net /usr/local/bin/ser2net --data-dir /var/lib/ser2net --set-password admin
ExecStart=/usr/local/bin/ser2net --data-dir /var/lib/ser2net
Restart=on-failure
RestartSec=3
# Open files: each running mapping holds about three (serial port, listener, log) plus
# one per client (see ser2net.service).
LimitNOFILE=65536

# --- Hardening (as ser2net.service; StateDirectory is writable without ReadWritePaths) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# (the binary unpacks itself into $TMPDIR, here the service's own /tmp, on every start)
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK: the list of network interfaces (see ser2net.service)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# MemoryDenyWriteExecute=true   # enable only after verifying ctypes/Python startup
# UMask=0077

[Install]
WantedBy=multi-user.target
