[Unit]
Description=ser2net — serial-to-network bridge with web config UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated unprivileged user that is a member of the 'dialout' group
# so it can open serial devices (NEVER run this as root).
User=ser2net
SupplementaryGroups=dialout
WorkingDirectory=/opt/ser2net
# On a headless first boot the console picker is non-interactive and defaults the
# admin UI to 127.0.0.1:8080 (loopback, never network-exposed without an explicit
# choice). To expose it on the LAN, run "systemctl edit ser2net" and add
#   [Service]
#   Environment=SER2NET_BIND_IP=0.0.0.0 SER2NET_PORT=8080
# (README: "Run as a service"). Commands run by hand on this data directory go as the
# service user, never as root (root would own what they write, and the service could no
# longer read it): sudo -u ser2net python3 /opt/ser2net/ser2net.py --data-dir
# /opt/ser2net/data --set-password admin
# The directories ser2net writes to (see ReadWritePaths below) are made for the
# service user on the first start if they are missing ("+": run without the sandbox).
ExecStartPre=+/bin/sh -c 'test -d /opt/ser2net/data || install -d -o ser2net -g ser2net -m 0700 /opt/ser2net/data'
ExecStartPre=+/bin/sh -c 'test -d /opt/ser2net/lib || install -d -o ser2net -g ser2net -m 0700 /opt/ser2net/lib'
# Python 3.10 or newer. Where /usr/bin/python3 is older (RHEL / AlmaLinux / Rocky 8 and 9,
# Debian 11) put a newer one here (RHEL: dnf install python3.11, then /usr/bin/python3.11),
# or run the standalone binary with systemd/ser2net-standalone.service instead.
ExecStart=/usr/bin/python3 /opt/ser2net/ser2net.py --data-dir /opt/ser2net/data
Restart=on-failure
RestartSec=3
# Open files: each running mapping holds about three (serial port, listener, log) plus
# one per client. systemd's default soft limit is 1024; ser2net also raises its soft
# limit at start (toward the hard limit, at most 65536), so an older copy of this unit
# without the line below works too.
LimitNOFILE=65536

# --- Hardening ---
NoNewPrivileges=true
# Writable paths (rest of FS is read-only under ProtectSystem=strict):
#  - /opt/ser2net/data : config.json + logs (adjust to your --data-dir)
#  - /opt/ser2net/lib  : where the first-run offline bootstrap installs the bundled
#    wheels. Without it ProtectSystem=strict makes ./lib read-only and the first
#    start fails to install dependencies. If you instead pre-install deps at deploy
#    time (python3 bootstrap.py) and add --no-bootstrap to ExecStart, you can drop
#    /opt/ser2net/lib from this list.
# Both must exist when the service starts: the ExecStartPre= lines above make them.
ReadWritePaths=/opt/ser2net/data /opt/ser2net/lib
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK: the list of network interfaces and their addresses (the bind-IP pickers,
# the cluster's directed broadcasts) is read over netlink; pyudev's event-driven hotplug
# uses it too (without pyudev ser2net polls for serial ports, which works fine).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# MemoryDenyWriteExecute=true   # enable only after verifying ctypes/Python startup
# UMask=0077

[Install]
WantedBy=multi-user.target
