# coverage.py settings for tests/coverage_run.py (CI job "coverage").
[run]
source = ser2netweb
parallel = True
# the servers the tests spawn stop on SIGTERM; save their data then too
sigterm = True
# one absolute data path for every process, whatever its working directory
data_file = ${SER2NETWEB_COV_DATA-.coverage}

[paths]
# tests/test_install_layout.py runs a copy of the package laid out as pip installs it, in a
# temporary site-packages folder (and as a distribution's package, in dist-packages) that is
# gone by the report: its lines are the package's
source =
    ser2netweb/
    */site-packages/ser2netweb/
    */dist-packages/ser2netweb/

[report]
precision = 1
exclude_also =
    if TYPE_CHECKING:
    pragma: no cover
    raise NotImplementedError
