# The release tags of github.com/haliskilic/ser2netweb (vX.Y.Z), through GitHub's API (its
# tags page loads them with JavaScript). The tarball is repacked without vendor/wheels
# (Files-Excluded in debian/copyright): +ds.
version=4
opts="searchmode=plain, \
      filenamemangle=s%.*/v?@ANY_VERSION@%@PACKAGE@-$1.tar.gz%, \
      repacksuffix=+ds, dversionmangle=s/\+ds\d*$//, repack, compression=xz" \
  https://api.github.com/repos/haliskilic/ser2netweb/tags?per_page=100 \
  https://api.github.com/repos/haliskilic/ser2netweb/tarball/refs/tags/v@ANY_VERSION@
