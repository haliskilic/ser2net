<!-- Chocolatey's package of the release's ser2netweb-windows-x64.exe: tools\chocolateyinstall.ps1
     downloads it (checked against its SHA-256) into the package's tools folder, and Chocolatey
     puts a shim for it on PATH. For a release, `python tools/windows_channels.py chocolatey vX.Y.Z`
     sets <version>, <releaseNotes> and the download from the release's SHA256SUMS;
     .github/workflows/chocolatey.yml packs, installs and pushes it. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>ser2netweb</id>
    <version>3.0.0</version>
    <packageSourceUrl>https://github.com/haliskilic/ser2netweb/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>haliskilic</owners>
    <title>ser2netweb</title>
    <authors>Halis KILIÇ</authors>
