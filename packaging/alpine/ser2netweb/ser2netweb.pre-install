#!/bin/sh

# the account the service runs as, in the group of the serial ports
addgroup -S ser2netweb 2>/dev/null
adduser -S -D -H -h /var/lib/ser2netweb -s /sbin/nologin -G ser2netweb \
	-g "ser2netweb serial-to-network bridge" ser2netweb 2>/dev/null
addgroup ser2netweb dialout 2>/dev/null

exit 0
