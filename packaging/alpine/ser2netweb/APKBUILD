# Contributor: Halis KILIÇ <mail@haliskilic.com.tr>
# Maintainer: Halis KILIÇ <mail@haliskilic.com.tr>
# Kept in packaging/alpine/ser2netweb/ of https://github.com/haliskilic/ser2netweb (CI
# builds it in an alpine:edge container: .github/workflows/distro-packages.yml;
# tools/bump_recipes.py moves it to a release).
pkgname=ser2netweb
pkgver=3.0.1
pkgrel=0
pkgdesc="Serial-to-network bridge with a web UI: raw TCP, telnet, RFC 2217, UDP, Modbus, MQTT"
url="https://github.com/haliskilic/ser2netweb"
arch="noarch"
# ser2netweb: AGPL-3.0-only; copied code of pyserial-asyncio-fast and Starlette:
# BSD-3-Clause; xterm.js and its fit addon: MIT; htmx: 0BSD
license="AGPL-3.0-only AND BSD-3-Clause AND MIT AND 0BSD"
# pyserial-asyncio-fast is not in Alpine: ser2netweb runs on its built-in copy of that
# library's serial transport (ser2netweb/engine/serial_transport.py)
depends="
	python3
	py3-h11
	py3-jinja2
	py3-markupsafe
	py3-psutil
	py3-pyserial
	py3-python-multipart
	py3-starlette
	py3-websockets
	uvicorn
	"
makedepends="
	py3-gpep517
	py3-installer
	py3-setuptools
	py3-wheel
	"
# (the time stamp tests read zone files)
checkdepends="tzdata"
install="$pkgname.pre-install"
subpackages="$pkgname-pyc $pkgname-doc $pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://github.com/haliskilic/ser2netweb/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	"
# the tests that start no server and open no network socket (each a script)
_check_tests="
	test_access_policy.py
	test_clock_check.py
	test_cluster_peer_save.py
	test_config_types.py
	test_config_validation.py
	test_console_log.py
	test_dependency_internals.py
	test_env_bind.py
	test_explain.py
	test_kept_names.py
	test_live_table.py
	test_log_maintenance.py
	test_log_read.py
	test_log_rotation.py
	test_login_throttle.py
	test_mapping_form_roundtrip.py
	test_mixed_version_edit.py
	test_modbus_frame.py
	test_modbus_write.py
	test_password_hashing.py
	test_protocol_commands.py
	test_public_url.py
	test_retention.py
	test_rfc2217_readonly.py
	test_rfc2217_settings.py
	test_secure_cookies.py
	test_ser2net_import.py
	test_serial_compat.py
	test_serial_mqtt.py
	test_sparkplug.py
	test_sparkplug_node.py
	test_starlette_compat.py
	test_text_fold.py
	test_time_stamps.py
	test_traffic_counters.py
	test_trusted_proxies.py
	test_ui_contrast.py
	test_ui_markup.py
	"

prepare() {
	default_prepare
	# ser2netweb/distro.json (pyproject.toml takes it into the wheel): the distribution
	# ser2netweb names in --about, its service's data directory (the default without
	# --data-dir) and how an optional package is installed, for the hint about a missing one
	printf '%s\n' '{"distribution": "Alpine Linux", "data_dir": "/var/lib/ser2netweb", "optional": "doas apk add py3-{dist}"}' >ser2netweb/distro.json
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	local t
	for t in $_check_tests; do
		PYTHONDONTWRITEBYTECODE=1 python3 tests/$t
	done
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
	install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname \
		LICENSE NOTICE COMMERCIAL_LICENSE.md THIRD-PARTY-NOTICES.md
	install -Dm644 -t "$pkgdir"/usr/share/doc/$pkgname README.en.md README.md CHANGELOG.md
}

