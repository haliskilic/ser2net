#!/bin/sh
# The web UI listens on 127.0.0.1:8080 unless ./conf exports SER2NETWEB_BIND_IP and
# SER2NETWEB_PORT (they win over the web UI's own setting), e.g.
#   export SER2NETWEB_BIND_IP=0.0.0.0 SER2NETWEB_PORT=8080
# OPTS in ./conf: more command line arguments (ser2netweb --help).
exec 2>&1
[ -r conf ] && . ./conf
exec chpst -u _ser2netweb:_ser2netweb:dialout ser2netweb --data-dir /var/lib/ser2netweb ${OPTS}
