# Template file for 'ser2netweb'
pkgname=ser2netweb
version=3.0.1
revision=1
build_style=python3-pep517
hostmakedepends="python3-setuptools"
# pyserial-asyncio-fast is not in Void: ser2netweb runs on its built-in copy of that
# library's serial transport (ser2netweb/engine/serial_transport.py); post_patch takes it
# out of pyproject.toml, so the python dependency check agrees
depends="python3-h11 python3-Jinja2 python3-MarkupSafe python3-psutil python3-pyserial
 python3-python-multipart python3-starlette python3-uvicorn python3-websockets"
checkdepends="${depends}"
short_desc="Serial-to-network bridge with a web UI"
maintainer="Halis KILIÇ <mail@haliskilic.com.tr>"
license="AGPL-3.0-only, BSD-3-Clause, 0BSD, MIT"
homepage="https://github.com/haliskilic/ser2netweb"
changelog="https://raw.githubusercontent.com/haliskilic/ser2netweb/main/CHANGELOG.md"
distfiles="https://github.com/haliskilic/ser2netweb/archive/refs/tags/v${version}.tar.gz"
checksum=23dce72d41f2dddba7793aed0b31721c0608b2b3d8ce2e8347f2ee26e1a4c20b
make_dirs="/var/lib/ser2netweb 0700 _ser2netweb _ser2netweb"
system_accounts="_ser2netweb"
_ser2netweb_homedir="/var/lib/ser2netweb"
_ser2netweb_descr="ser2netweb serial-to-network bridge"
_ser2netweb_groups="dialout"

post_patch() {
	vsed -i '/"pyserial-asyncio-fast>=/d' pyproject.toml
	# ser2netweb/distro.json (pyproject.toml takes it into the wheel): the distribution
	# ser2netweb names in --about, its service's data directory (the default without
	# --data-dir) and how an optional package is installed, for the hint about a missing one
	printf '%s\n' '{"distribution": "Void Linux", "data_dir": "/var/lib/ser2netweb", "optional": {"paho-mqtt": "sudo xbps-install python3-paho_mqtt", "ldap3": "sudo xbps-install python3-ldap3", "cryptography": "sudo xbps-install python3-cryptography"}}' \
		>ser2netweb/distro.json
}

do_check() {
	# The whole suite (tests/run_all.py) also compares the pinned versions of the
	# release files; these run on Void's own: the configuration, sign-in and the REST API
	local t
	for t in test_config_validation test_web_auth test_rest_api; do
		SER2NETWEB_SKIP_PIN_CHECKS=1 python3 tests/${t}.py
	done
}

post_install() {
	vsv ser2netweb
	vlicense THIRD-PARTY-NOTICES.md
	vlicense tools/licenses/npm/htmx.org.txt
	vlicense tools/licenses/npm/xterm.txt
	vlicense tools/licenses/npm/xterm-addon-fit.txt
}
