_ser2netweb_descr="ser2netweb serial-to-network bridge"
_ser2netweb_groups="dialout"

do_check() {
	# The whole suite (tests/run_all.py) also compares the pinned versions of the
	# release files; these run on Void's own: the configuration, sign-in and the REST API
	local t
	for t in test_config_validation test_web_auth test_rest_api; do
		SER2NETWEB_SKIP_PIN_CHECKS=1 python3 tests/${t}.py
	done
}

post_install() {
	vsv ser2netweb
	vlicense THIRD-PARTY-NOTICES.md
	vlicense tools/licenses/npm/htmx.org.txt
	vlicense tools/licenses/npm/xterm.txt
	vlicense tools/licenses/npm/xterm-addon-fit.txt
}
