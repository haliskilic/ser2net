# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           python 1.0

github.setup        haliskilic ser2netweb 3.0.0 v
github.tarball_from archive
revision            0

categories          net comms python
platforms           {darwin any}
supported_archs     noarch
# the web UI's static files carry htmx (0BSD) and xterm.js (MIT)
license             AGPL-3 MIT Permissive
maintainers         {@haliskilic} openmaintainer

description         serial-to-network bridge with a web UI
long_description    ser2netweb shares serial ports over the network: raw TCP, telnet, \
                    RFC 2217, UDP, a Modbus RTU/TCP gateway and MQTT, configured in a web \
                    UI or over a REST API. It is an independent project, unrelated to \
                    Corey Minyard's ser2net.

checksums           rmd160  413581158a7ac6ba63ebbd5c27e999d3d6db447e \
                    sha256  b6610d614abce4071895f4a3d829da61cb87ddc7890034584a8ea5d71a60d0e5 \
                    size    6265860

python.default_version 314

depends_lib-append  port:py${python.version}-h11 \
                    port:py${python.version}-jinja2 \
                    port:py${python.version}-markupsafe \
                    port:py${python.version}-psutil \
                    port:py${python.version}-pyserial-asyncio-fast \
                    port:py${python.version}-python-multipart \
                    port:py${python.version}-serial \
                    port:py${python.version}-starlette \
                    port:py${python.version}-uvicorn \
                    port:py${python.version}-websockets

set datadir         ${prefix}/var/db/${name}

add_users           _${name} group=_${name} realname=ser2netweb home=${datadir} \
                    shell=/usr/bin/false

destroot.keepdirs   ${destroot}${datadir}

post-destroot {
    xinstall -d -m 0700 -o _${name} -g _${name} ${destroot}${datadir}
}

startupitem.create      yes
startupitem.executable  ${prefix}/bin/${name} --data-dir ${datadir}
startupitem.user        _${name}
startupitem.group       _${name}

variant ldap description {LDAP / Active Directory sign-in} {
    depends_lib-append  port:py${python.version}-ldap3
}

variant tls description {Self-signed TLS certificates in-process} {
    depends_lib-append  port:py${python.version}-cryptography
}

notes "
ser2netweb runs as the user _${name} with its data in ${datadir}:\
sudo port load ${name} starts it now and at every boot. The web UI then listens\
on 127.0.0.1:8080; set the first admin password there, or with\
sudo -u _${name} ${prefix}/bin/${name} --data-dir ${datadir} --set-password admin
"
