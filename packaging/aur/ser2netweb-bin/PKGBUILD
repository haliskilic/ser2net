pkgname=ser2netweb-bin
pkgver=3.0.0
pkgrel=1
pkgdesc='Serial-to-network bridge with a web UI: raw TCP, telnet, RFC 2217, UDP, Modbus, MQTT (standalone executable)'
arch=('x86_64' 'aarch64')
url='https://github.com/haliskilic/ser2netweb'
license=('AGPL-3.0-only')
depends=('glibc' 'zlib')
provides=('ser2netweb')
conflicts=('ser2netweb')
# a PyInstaller executable: its archive follows the ELF part, which strip would cut off
options=('!strip' '!debug')
install=ser2netweb-bin.install
_release="$url/releases/download/v$pkgver"
_raw="https://raw.githubusercontent.com/haliskilic/ser2netweb/v$pkgver"
source=('ser2netweb.service'
        'ser2netweb.sysusers'
        'ser2netweb.tmpfiles'
        "LICENSE-$pkgver::$_raw/LICENSE"
        "NOTICE-$pkgver::$_raw/NOTICE"
        "COMMERCIAL_LICENSE-$pkgver.md::$_raw/COMMERCIAL_LICENSE.md"
        "THIRD-PARTY-NOTICES-$pkgver.md::$_raw/THIRD-PARTY-NOTICES.md")
source_x86_64=("ser2netweb-linux-x64-$pkgver::$_release/ser2netweb-linux-x64"
               "ser2netweb-linux-x64-$pkgver.THIRD-PARTY-LICENSES.txt::$_release/ser2netweb-linux-x64.THIRD-PARTY-LICENSES.txt")
source_aarch64=("ser2netweb-linux-arm64-$pkgver::$_release/ser2netweb-linux-arm64"
                "ser2netweb-linux-arm64-$pkgver.THIRD-PARTY-LICENSES.txt::$_release/ser2netweb-linux-arm64.THIRD-PARTY-LICENSES.txt")
sha256sums=('f6e7d3da48864014d8c5eebbc671da06095630a7ba865b033436c9949d574183'
            '0cea68d0e0ba7499fdad0395eb63d1a976738ca2e881e3b53102b0789c6201b0'
            '576bcbb2318b88a72ebffdbfcce9e4d580bfa436dcb37b06768c2d69f88186a0'
            '8d56b405468aad11f87ab5763f901e276e08d9646ff5c8481b1762b6b789e9ed'
            '1b1dd0fbba6a2ca56298199a7a87a5c1f60087107b90ad63593ee723e69bf26c'
            'c23528a884a89a21a415557269330ab33c2ad793c4e0216f5d129a81b68ea00d'
            'eb68d38489ba288c03baad23928ecd03c62ba8f950af549cbe9e5c118e11132a')
sha256sums_x86_64=('8a6cc5a09f0bde0fd65a1abb719da595e418a6c21233850454c216b63f0087d0'
                   '4899e85eb9074dddff4fc328843131cff324bda2b13cd72a9b643e306de2b4dc')
sha256sums_aarch64=('077e5bf20ce3873a1f4edd348f68e852bb34b5aafc9e1ba43befef0ff1856fe9'
                    '861405a8eccd0da74cf4514186aa1d639b5192d7bdbc6cd366ac3499a1acfd52')

package() {
  local exe=ser2netweb-linux-x64
  [[ $CARCH == aarch64 ]] && exe=ser2netweb-linux-arm64
  install -Dm755 "$exe-$pkgver" "$pkgdir/usr/bin/ser2netweb"
  install -Dm644 ser2netweb.service "$pkgdir/usr/lib/systemd/system/ser2netweb.service"
  install -Dm644 ser2netweb.sysusers "$pkgdir/usr/lib/sysusers.d/ser2netweb.conf"
  install -Dm644 ser2netweb.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/ser2netweb.conf"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "NOTICE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "COMMERCIAL_LICENSE-$pkgver.md" "$pkgdir/usr/share/licenses/$pkgname/COMMERCIAL_LICENSE.md"
  install -Dm644 "THIRD-PARTY-NOTICES-$pkgver.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
  install -Dm644 "$exe-$pkgver.THIRD-PARTY-LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES.txt"
}
