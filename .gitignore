# Offline-installed dependencies (regenerated by bootstrap.py from vendor/wheels)
/lib/

# Runtime state: config + activity log (delete both to fully reset)
/data/

# Python
__pycache__/
*.py[cod]
.venv/

# PyInstaller build output (release binaries are built in CI)
/build/
/dist/

# coverage (tests/coverage_run.py)
.coverage
.coverage.*
coverage.txt
coverage-html/

# the PyPI package build (python -m build)
/*.egg-info/
